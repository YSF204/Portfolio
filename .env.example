# Local Express server only. On Vercel the contact endpoint is the serverless
# function in api/, which needs just the SMTP_* and CONTACT_TO values below.
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Only when the API lives on a different host than the site. Leave unset on
# Vercel, where /api/contact is same-origin.
# VITE_CONTACT_API=

# Gmail delivery for the contact form.
# SMTP_PASS is a Google App Password (16 characters, not your Gmail password) —
# generate one at https://myaccount.google.com/apppasswords with 2-Step
# Verification enabled. Never commit the filled-in .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yousef204b@gmail.com
SMTP_PASS=
SMTP_FROM=yousef204b@gmail.com
CONTACT_TO=yousef204b@gmail.com
